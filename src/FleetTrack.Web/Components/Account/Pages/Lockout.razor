@page "/Account/Lockout"
@attribute [AllowAnonymous]

<PageTitle>Account locked</PageTitle>

<h1>Account locked</h1>
<p class="auth-subtitle" role="alert">
    Too many incorrect sign-in attempts. For your security this account is locked for 15 minutes.
    Try again later, or ask an administrator to unlock it.
</p>
<a class="btn btn-outline-secondary w-100" href="Account/Login">Back to sign in</a>
