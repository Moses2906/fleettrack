@* The one card style used on every page: a title, optional actions on the right, then the content.
   Keeping every page on this component is what makes FleetTrack look consistent. *@
<MudPaper Outlined="true" Elevation="0" Class="@($"ft-card {Class}")">
    @if (Title is not null || Actions is not null)
    {
        <div class="ft-card-header">
            <div>
                @if (Title is not null)
                {
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="ft-card-title">@Title</MudText>
                }
                @if (Subtitle is not null)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@Subtitle</MudText>
                }
            </div>
            @if (Actions is not null)
            {
                <div class="d-flex align-center gap-2 flex-wrap">@Actions</div>
            }
        </div>
    }
    <div class="@(Flush ? "" : "ft-card-body")">@ChildContent</div>
</MudPaper>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>No padding around the content, for tables and lists that run edge to edge.</summary>
    [Parameter] public bool Flush { get; set; }

    [Parameter] public string? Class { get; set; }
}
