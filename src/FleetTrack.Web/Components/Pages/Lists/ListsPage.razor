@page "/lists"
@attribute [Authorize(Policy = nameof(Permission.ViewRecords))]
@inject ReferenceDataService ReferenceData
@inject PermissionService Permissions
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Drivers & owners · FleetTrack</PageTitle>

<PageHeader Title="Drivers & owners" Subtitle="The people and companies vehicles are assigned and licensed to, and the vehicle categories." />

<MudPaper Outlined="true" Elevation="0">
    <MudTabs Elevation="0" ApplyEffectsToContainer="true" @bind-ActivePanelIndex="tab">
        <MudTabPanel Text="Drivers" Icon="@Icons.Material.Rounded.Badge">
            <div class="d-flex justify-end pa-3 pb-0">
                @if (canEdit)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="() => EditDriverAsync(null)">Add driver</MudButton>
                }
            </div>
            <MudTable Items="drivers" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm" Loading="drivers is null">
                <HeaderContent>
                    <MudTh>Name</MudTh><MudTh>Phone</MudTh><MudTh>Email</MudTh><MudTh>Licence no.</MudTh><MudTh>Vehicles</MudTh><MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">
                        @context.FullName
                        @if (!context.IsActive)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ml-1">Inactive</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Phone">@(context.Phone ?? "—")</MudTd>
                    <MudTd DataLabel="Email">@(context.Email ?? "—")</MudTd>
                    <MudTd DataLabel="Licence no.">@(context.DriverLicenceNumber ?? "—")</MudTd>
                    <MudTd DataLabel="Vehicles">@context.VehicleCount</MudTd>
                    <MudTd Style="text-align: right">
                        <RowActions CanEdit="canEdit" CanDelete="canDelete" OnEdit="() => EditDriverAsync(context.Id)"
                                    OnDelete="() => DeleteDriverAsync(context)" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><EmptyState Icon="@Icons.Material.Rounded.Badge" Title="No drivers yet" /></NoRecordsContent>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Licence holders" Icon="@Icons.Material.Rounded.Business">
            <div class="d-flex justify-end pa-3 pb-0">
                @if (canEdit)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="() => EditHolderAsync(null)">Add licence holder</MudButton>
                }
            </div>
            <MudTable Items="holders" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm" Loading="holders is null">
                <HeaderContent>
                    <MudTh>Name</MudTh><MudTh>Type</MudTh><MudTh>Reg. / ID number</MudTh><MudTh>Vehicles</MudTh><MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Type">@(context.HolderType == HolderType.Company ? "Company" : "Individual")</MudTd>
                    <MudTd DataLabel="Number">@context.IdentifierMasked</MudTd>
                    <MudTd DataLabel="Vehicles">@context.VehicleCount</MudTd>
                    <MudTd Style="text-align: right">
                        <RowActions CanEdit="canEdit" CanDelete="canDelete" OnEdit="() => EditHolderAsync(context.Id)"
                                    OnDelete="() => DeleteHolderAsync(context)" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><EmptyState Icon="@Icons.Material.Rounded.Business" Title="No licence holders yet" /></NoRecordsContent>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Categories" Icon="@Icons.Material.Rounded.Category">
            <div class="d-flex justify-end pa-3 pb-0">
                @if (canEdit)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="() => EditCategoryAsync(null)">Add category</MudButton>
                }
            </div>
            <MudTable Items="categories" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm" Loading="categories is null">
                <HeaderContent>
                    <MudTh>Name</MudTh><MudTh>Description</MudTh><MudTh>Vehicles</MudTh><MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">
                        @context.Name
                        @if (!context.IsActive)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ml-1">Inactive</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Description">@(context.Description ?? "—")</MudTd>
                    <MudTd DataLabel="Vehicles">@context.VehicleCount</MudTd>
                    <MudTd Style="text-align: right">
                        <RowActions CanEdit="canEdit" CanDelete="canDelete" OnEdit="() => EditCategoryAsync(context)"
                                    OnDelete="() => DeleteCategoryAsync(context)" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@code {
    private int tab;
    private List<DriverRow>? drivers;
    private List<LicenceHolderRow>? holders;
    private List<CategoryRow>? categories;
    private bool canEdit;
    private bool canDelete;

    protected override async Task OnInitializedAsync()
    {
        canEdit = await Permissions.HasAsync(Permission.EditRecords);
        canDelete = await Permissions.HasAsync(Permission.DeleteRecords);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        drivers = await ReferenceData.ListDriversAsync();
        holders = await ReferenceData.ListLicenceHoldersAsync();
        categories = await ReferenceData.ListCategoriesAsync();
    }

    private async Task EditDriverAsync(int? id)
    {
        var dialog = await Dialogs.ShowAsync<DriverDialog>(id is null ? "Add driver" : "Edit driver",
            new DialogParameters<DriverDialog> { { d => d.DriverId, id } });
        await AfterDialogAsync(dialog, "Driver saved.");
    }

    private async Task EditHolderAsync(int? id)
    {
        var dialog = await Dialogs.ShowAsync<LicenceHolderDialog>(id is null ? "Add licence holder" : "Edit licence holder",
            new DialogParameters<LicenceHolderDialog> { { d => d.HolderId, id } });
        await AfterDialogAsync(dialog, "Licence holder saved.");
    }

    private async Task EditCategoryAsync(CategoryRow? category)
    {
        var dialog = await Dialogs.ShowAsync<CategoryDialog>(category is null ? "Add category" : "Edit category",
            new DialogParameters<CategoryDialog> { { d => d.Existing, category } });
        await AfterDialogAsync(dialog, "Category saved.");
    }

    private async Task AfterDialogAsync(IDialogReference dialog, string message)
    {
        if ((await dialog.Result) is { Canceled: false })
        {
            Snackbar.Add(message, Severity.Success);
            await LoadAsync();
        }
    }

    private Task DeleteDriverAsync(DriverRow d) =>
        DeleteAsync(d.FullName, () => ReferenceData.DeleteDriverAsync(d.Id),
            d.VehicleCount > 0 ? $" They will be unassigned from {d.VehicleCount} vehicle(s)." : "");

    private Task DeleteHolderAsync(LicenceHolderRow h) =>
        DeleteAsync(h.Name, () => ReferenceData.DeleteLicenceHolderAsync(h.Id), "");

    private Task DeleteCategoryAsync(CategoryRow c) =>
        DeleteAsync(c.Name, () => ReferenceData.DeleteCategoryAsync(c.Id), "");

    private async Task DeleteAsync(string name, Func<Task<OperationResult>> delete, string extraWarning)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Delete", $"Permanently delete {name}?{extraWarning} This can't be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
            return;

        var result = await delete();
        Snackbar.Add(result.Succeeded ? $"{name} deleted." : result.Error ?? "Couldn't delete.", result.Succeeded ? Severity.Success : Severity.Error);
        await LoadAsync();
    }
}
