@page "/renewals"
@attribute [Authorize(Policy = nameof(Permission.ViewRecords))]
@inject RenewalService Renewals
@inject VehicleService Vehicles
@inject PermissionService Permissions
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Licence renewals · FleetTrack</PageTitle>

<PageHeader Title="Licence renewals" Subtitle="Disks to renew, and what happened after each new disk was bought." />

@if (outlook is not null)
{
    <SectionCard Title="Disks due by month" Class="mb-4">
        @* One scrolling row of months; click one to see which vehicles. *@
        <div class="ft-month-strip">
            @if (outlook.AlreadyExpired > 0)
            {
                <a class="ft-month ft-month-expired" href="vehicles?status=expired">
                    <span class="ft-month-name">Expired</span>
                    <span class="ft-month-count">@outlook.AlreadyExpired</span>
                </a>
            }
            @foreach (var m in outlook.Months)
            {
                <a class="ft-month @(m.Count == 0 ? "ft-month-empty" : "")" href="@($"vehicles?month={m.Month}")"
                   aria-label="@($"{m.Count} disk(s) expiring in {m.Month.Display}")">
                    <span class="ft-month-name">@m.Month.ShortDisplay</span>
                    <span class="ft-month-count">@m.Count</span>
                </a>
            }
        </div>
    </SectionCard>
}

<MudGrid Spacing="4">
    <MudItem xs="12" lg="5">
        <SectionCard Title="To renew" Flush="true">
            @if (toRenew is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (toRenew.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Rounded.Verified" Title="Nothing to renew" Message="No disk is expired or due in the next 30 days." />
            }
            else
            {
                @foreach (var v in toRenew)
                {
                    <ListRow>
                        <Main>
                            <MudLink Href="@($"vehicles/{v.Id}?tab=renewals")" Class="ft-reg" Underline="Underline.Hover">@v.RegistrationNumber</MudLink>
                            <span class="ft-muted">@v.MakeAndModel</span>
                        </Main>
                        <Side>
                            <LicenceStatusChip ExpiryDate="v.LicenceExpiryDate" Today="today" />
                            @if (canEdit)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => RenewAsync(v)">Renew</MudButton>
                            }
                        </Side>
                    </ListRow>
                }
            }
        </SectionCard>
    </MudItem>

    <MudItem xs="12" lg="7">
        <SectionCard Title="Recent renewals" Subtitle="The last 90 days" Flush="true">
            <Actions>
                <MudSwitch @bind-Value="outstandingOnly" Color="Color.Primary" Label="Steps outstanding" />
            </Actions>
            <ChildContent>
                @if (renewals is null)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else if (!VisibleRenewals.Any())
                {
                    <EmptyState Icon="@Icons.Material.Rounded.TaskAlt" Title="Nothing outstanding" Message="Every recent disk has been handed over, fitted and filed." />
                }
                else
                {
                    @foreach (var renewal in VisibleRenewals)
                    {
                        <RenewalCard Renewal="renewal" ShowVehicle="true" CanEdit="canEdit" CanDelete="canDelete" OnChanged="LoadAsync" />
                    }
                }
            </ChildContent>
        </SectionCard>
    </MudItem>
</MudGrid>
@code {
    private List<VehicleRow>? toRenew;
    private ExpiryOutlook? outlook;
    private List<RenewalRow>? renewals;
    private DateOnly today;
    private bool outstandingOnly;
    private bool canEdit, canDelete;

    // The last 90 days of renewals; older ones are on each vehicle's page and in its history.
    private IEnumerable<RenewalRow> VisibleRenewals =>
        (renewals ?? []).Where(r => r.DatePurchased >= today.AddDays(-90) && (!outstandingOnly || r.OutstandingSteps.Any()));

    protected override async Task OnInitializedAsync()
    {
        today = Renewals.Today;
        canEdit = await Permissions.HasAsync(Permission.EditRecords);
        canDelete = await Permissions.HasAsync(Permission.DeleteRecords);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var all = await Vehicles.ListAsync();
        outlook = ExpiryCalendar.ByMonth(all.Select(v => v.LicenceExpiryDate), today);
        toRenew = all
            .Where(v => v.StatusOn(today) != LicenceStatus.Valid)
            .OrderBy(v => v.LicenceExpiryDate)
            .ToList();
        renewals = await Renewals.ListAsync();
    }

    private async Task RenewAsync(VehicleRow vehicle)
    {
        var dialog = await Dialogs.ShowAsync<RenewalDialog>($"Renew {vehicle.RegistrationNumber}",
            new DialogParameters<RenewalDialog> { { d => d.VehicleId, vehicle.Id }, { d => d.CurrentExpiry, vehicle.LicenceExpiryDate } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false })
        {
            Snackbar.Add($"{vehicle.RegistrationNumber} renewed. Record the handover, fitting and filing below as they happen.", Severity.Success);
            await LoadAsync();
        }
    }
}
