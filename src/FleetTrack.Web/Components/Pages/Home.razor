@page "/"
@attribute [Authorize(Policy = nameof(Permission.ViewRecords))]
@inject VehicleService Vehicles
@inject ServiceLogService ServiceLog

<PageTitle>Dashboard · FleetTrack</PageTitle>

<AuthorizeView Context="auth">
    <PageHeader Title="@($"Hello, {FirstName(auth.User.DisplayName())}")" Subtitle="@($"{today:dddd d MMMM yyyy}")" />
</AuthorizeView>

@if (summary is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid Spacing="4" Class="mb-1">
        <MudItem xs="6" md="3">
            <StatCard Href="vehicles" Label="Vehicles" Value="summary.TotalVehicles" Icon="@Icons.Material.Rounded.DirectionsCar" Colour="Color.Primary" />
        </MudItem>
        <MudItem xs="6" md="3">
            <StatCard Href="vehicles?status=expired" Label="Expired disks" Value="summary.Expired" Icon="@Icons.Material.Rounded.Error" Colour="Color.Error" />
        </MudItem>
        <MudItem xs="6" md="3">
            <StatCard Href="vehicles?status=due" Label="Due within 30 days" Value="summary.DueSoon" Icon="@Icons.Material.Rounded.Schedule" Colour="Color.Warning" />
        </MudItem>
        <MudItem xs="6" md="3">
            <StatCard Href="vehicles?missing=true" Label="Missing documents" Value="summary.MissingDocuments" Icon="@Icons.Material.Rounded.FolderOff" Colour="Color.Secondary" />
        </MudItem>
    </MudGrid>

    @* One card with tabs, instead of three lists competing for attention. *@
    <SectionCard Title="Needs attention" Flush="true">
        <MudTabs Elevation="0" ApplyEffectsToContainer="true" @bind-ActivePanelIndex="tab" Class="ft-attention-tabs">
            <MudTabPanel Text="@($"Licence disks · {summary.LicenceAttention.Count}")">
                @if (summary.LicenceAttention.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Rounded.Verified" Title="All disks are valid" Message="Nothing expires in the next 30 days." />
                }
                @foreach (var v in summary.LicenceAttention)
                {
                    <ListRow Href="@($"vehicles/{v.Id}")">
                        <Main><span class="ft-reg">@v.RegistrationNumber</span> <span class="ft-muted">@v.MakeAndModel</span></Main>
                        <Side><LicenceStatusChip ExpiryDate="v.LicenceExpiryDate" Today="today" /></Side>
                    </ListRow>
                }
            </MudTabPanel>
            <MudTabPanel Text="@($"Documents · {summary.DocumentAttention.Count}")">
                @if (summary.DocumentAttention.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Rounded.FolderSpecial" Title="Every document is on file" />
                }
                @foreach (var v in summary.DocumentAttention)
                {
                    <ListRow Href="@($"vehicles/{v.Id}?tab=documents")">
                        <Main><span class="ft-reg">@v.RegistrationNumber</span> <span class="ft-muted">@MissingNames(v)</span></Main>
                        <Side><MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Class="ma-0">@v.MissingDocumentCount missing</MudChip></Side>
                    </ListRow>
                }
            </MudTabPanel>
            <MudTabPanel Text="@($"Services · {servicesDue.Count}")">
                @if (servicesDue.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Rounded.EventAvailable" Title="No services due" Message="Nothing is overdue or due in the next 30 days." />
                }
                @foreach (var r in servicesDue)
                {
                    <ListRow Href="@($"vehicles/{r.VehicleId}?tab=services")">
                        <Main><span class="ft-reg">@r.RegistrationNumber</span> <span class="ft-muted">@r.MakeAndModel</span></Main>
                        <Side><ServiceReminderChip DueDate="r.NextServiceDue" Today="today" /></Side>
                    </ListRow>
                }
            </MudTabPanel>
        </MudTabs>
    </SectionCard>
}

@code {
    private DashboardSummary? summary;
    private List<ServiceReminderRow> servicesDue = [];
    private DateOnly today;
    private int tab;

    protected override async Task OnInitializedAsync()
    {
        today = Vehicles.Today;
        summary = await Vehicles.GetDashboardAsync();
        servicesDue = (await ServiceLog.RemindersAsync())
            .Where(r => r.ReminderOn(today) is ServiceReminder.Overdue or ServiceReminder.DueSoon)
            .ToList();
    }

    private static string MissingNames(VehicleRow v) =>
        string.Join(", ", DocumentTypes.All.Where(t => !v.HasDocument(t)).Select(DocumentTypes.Name));

    private static string FirstName(string name) => name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? name;
}
