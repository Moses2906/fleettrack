@* One row per required document: whether we have it (the checklist tick), the stored copy, and actions.
   This replaces the separate checklist card, so each document appears exactly once. *@
@inject DocumentService Documents
@inject VehicleService Vehicles
@inject PermissionService Permissions
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

@if (documents is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudSimpleTable Elevation="0" Hover="true" Class="ft-doc-table">
        <thead>
            <tr>
                <th>Document</th>
                <th>We have it</th>
                <th>Stored copy</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var type in DocumentTypes.All)
            {
                var doc = documents.FirstOrDefault(d => d.DocumentType == type);
                var held = Vehicle.Row.HasDocument(type);
                <tr>
                    <td>
                        <b>@DocumentTypes.Name(type)</b>
                        <div class="ft-muted">@DocumentTypes.Description(type)</div>
                    </td>
                    <td>
                        @if (canEdit)
                        {
                            @* Tick it if the paper copy is in the office; uploading a copy ticks it automatically. *@
                            <MudSwitch T="bool" Value="held" ValueChanged="value => SetHeldAsync(type, value)" Color="Color.Success"
                                       aria-label="@($"We have the {DocumentTypes.Name(type)}")" />
                        }
                        else if (held)
                        {
                            <MudIcon Icon="@Icons.Material.Rounded.CheckCircle" Color="Color.Success" Size="Size.Small" aria-label="Yes" />
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Class="ma-0">Missing</MudChip>
                        }
                    </td>
                    <td>
                        @if (doc is not null)
                        {
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@(doc.ContentType == "application/pdf" ? Icons.Material.Rounded.PictureAsPdf : Icons.Material.Rounded.Image)"
                                         Size="Size.Small" Class="mud-text-secondary" />
                                <div style="min-width: 0">
                                    <div class="text-truncate" style="max-width: 260px" title="@doc.OriginalFileName">@doc.OriginalFileName</div>
                                    <div class="ft-muted">@DocumentFileRules.FormatSize(doc.FileSizeBytes) · @SouthAfricanTime.ToLocal(doc.UploadedAtUtc).ToString("dd MMM yyyy")</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="ft-muted">@(held ? "Paper copy only" : "None")</span>
                        }
                    </td>
                    <td style="text-align: right; white-space: nowrap">
                        @if (doc is not null)
                        {
                            @* Opened through the permission-checked /documents endpoint; every open is audited. *@
                            <MudTooltip Text="View / print">
                                <MudIconButton Href="@($"documents/{doc.Id}")" Target="_blank" Icon="@Icons.Material.Rounded.Visibility" Size="Size.Small" aria-label="View or print" />
                            </MudTooltip>
                            <MudTooltip Text="Download">
                                <MudIconButton Href="@($"documents/{doc.Id}?download=true")" Target="_blank" Icon="@Icons.Material.Rounded.Download" Size="Size.Small" aria-label="Download" />
                            </MudTooltip>
                        }
                        @if (canUpload)
                        {
                            <MudTooltip Text="@(doc is null ? "Upload a copy" : "Replace the copy")">
                                <MudIconButton Icon="@(doc is null ? Icons.Material.Rounded.Upload : Icons.Material.Rounded.SwapHoriz)" Size="Size.Small"
                                               Color="@(doc is null ? Color.Primary : Color.Default)" OnClick="() => UploadAsync(type, doc)"
                                               aria-label="@(doc is null ? "Upload" : "Replace")" />
                            </MudTooltip>
                        }
                        @if (doc is not null && canDelete)
                        {
                            <MudTooltip Text="Delete the copy">
                                <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(doc)" aria-label="Delete copy" />
                            </MudTooltip>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    [Parameter, EditorRequired] public VehicleDetails Vehicle { get; set; } = default!;

    /// <summary>Raised after a change, so the vehicle page can refresh.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<DocumentInfo>? documents;
    private bool canEdit, canUpload, canDelete;

    protected override async Task OnInitializedAsync()
    {
        canEdit = await Permissions.HasAsync(Permission.EditRecords);
        canUpload = await Permissions.HasAsync(Permission.UploadDocuments);
        canDelete = await Permissions.HasAsync(Permission.DeleteRecords);
        await LoadAsync();
    }

    private async Task LoadAsync() => documents = await Documents.ListForVehicleAsync(Vehicle.Row.Id);

    private async Task SetHeldAsync(DocumentType type, bool held)
    {
        var result = await Vehicles.SetDocumentHeldAsync(Vehicle.Row.Id, type, held);
        if (!result.Succeeded)
            Snackbar.Add(result.Error ?? "Couldn't update the checklist.", Severity.Error);
        await OnChanged.InvokeAsync();
    }

    private async Task UploadAsync(DocumentType type, DocumentInfo? existing)
    {
        var parameters = new DialogParameters<UploadDocumentDialog>
        {
            { d => d.VehicleId, Vehicle.Row.Id },
            { d => d.Type, type },
            { d => d.Replacing, existing is not null },
            { d => d.ExistingNotes, existing?.Notes },
        };
        var dialog = await Dialogs.ShowAsync<UploadDocumentDialog>($"{(existing is null ? "Upload" : "Replace")} {DocumentTypes.Name(type)}", parameters);
        if ((await dialog.Result) is { Canceled: false })
        {
            Snackbar.Add($"{DocumentTypes.Name(type)} uploaded.", Severity.Success);
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
    }

    private async Task DeleteAsync(DocumentInfo doc)
    {
        var parameters = new DialogParameters<DeleteDocumentDialog>
        {
            { d => d.Type, doc.DocumentType },
            { d => d.FileName, doc.OriginalFileName },
        };
        var dialog = await Dialogs.ShowAsync<DeleteDocumentDialog>("Delete document copy", parameters);
        if ((await dialog.Result) is not { Canceled: false, Data: bool untick })
            return;

        var result = await Documents.DeleteAsync(doc.Id, untick);
        Snackbar.Add(result.Succeeded ? "Document copy deleted." : result.Error ?? "Couldn't delete the document.",
            result.Succeeded ? Severity.Success : Severity.Error);
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }
}
