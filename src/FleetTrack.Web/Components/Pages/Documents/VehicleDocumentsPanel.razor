@* The four document slots for one vehicle: view, download, upload, replace and delete. *@
@inject DocumentService Documents
@inject PermissionService Permissions
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

@if (documents is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid Spacing="3" Class="pa-2">
        @foreach (var type in DocumentTypes.All)
        {
            var doc = documents.FirstOrDefault(d => d.DocumentType == type);
            var ticked = Vehicle.Row.HasDocument(type);
            <MudItem xs="12" md="6">
                <MudPaper Outlined="true" Elevation="0" Class="pa-4 h-100 d-flex flex-column">
                    <div class="d-flex align-start justify-space-between gap-2">
                        <div>
                            <MudText Typo="Typo.subtitle1"><b>@DocumentTypes.Name(type)</b></MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@DocumentTypes.Description(type)</MudText>
                        </div>
                        @if (doc is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success" Icon="@Icons.Material.Rounded.CloudDone">Copy stored</MudChip>
                        }
                        else if (ticked)
                        {
                            <MudTooltip Text="Ticked on the checklist, but no copy has been uploaded.">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Icon="@Icons.Material.Rounded.Inventory2">Paper only</MudChip>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Icon="@Icons.Material.Rounded.Error">Missing</MudChip>
                        }
                    </div>

                    @if (doc is not null)
                    {
                        <div class="d-flex align-center gap-3 mt-4">
                            <MudIcon Icon="@(doc.ContentType == "application/pdf" ? Icons.Material.Rounded.PictureAsPdf : Icons.Material.Rounded.Image)"
                                     Color="@(doc.ContentType == "application/pdf" ? Color.Error : Color.Info)" />
                            <div style="min-width: 0">
                                <MudText Typo="Typo.body2" Class="text-truncate" title="@doc.OriginalFileName">@doc.OriginalFileName</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @DocumentFileRules.FormatSize(doc.FileSizeBytes) · @SouthAfricanTime.ToLocal(doc.UploadedAtUtc).ToString("dd MMM yyyy") · @doc.UploadedBy
                                </MudText>
                            </div>
                        </div>
                        @if (doc.Notes is not null)
                        {
                            <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary" Style="white-space: pre-line">@doc.Notes</MudText>
                        }
                        <MudSpacer />
                        <div class="d-flex flex-wrap gap-1 mt-3">
                            @* Opened in a new tab through the permission-checked /documents endpoint; every open is audited. *@
                            <MudButton Href="@($"documents/{doc.Id}")" Target="_blank" Size="Size.Small" Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Rounded.OpenInNew">View / print</MudButton>
                            <MudButton Href="@($"documents/{doc.Id}?download=true")" Target="_blank" Size="Size.Small" Variant="Variant.Text"
                                       StartIcon="@Icons.Material.Rounded.Download">Download</MudButton>
                            @if (canUpload)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.SwapHoriz"
                                           OnClick="() => UploadAsync(type, doc)">Replace</MudButton>
                            }
                            @if (canDelete)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Rounded.DeleteOutline"
                                           OnClick="() => DeleteAsync(doc)">Delete</MudButton>
                            }
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-4">No copy uploaded yet.</MudText>
                        <MudSpacer />
                        @if (canUpload)
                        {
                            <div class="mt-3">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Upload"
                                           OnClick="() => UploadAsync(type, null)">Upload</MudButton>
                            </div>
                        }
                    }
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    [Parameter, EditorRequired] public VehicleDetails Vehicle { get; set; } = default!;

    /// <summary>Raised after an upload or delete, so the vehicle page can refresh its checklist.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<DocumentInfo>? documents;
    private bool canUpload;
    private bool canDelete;

    protected override async Task OnInitializedAsync()
    {
        canUpload = await Permissions.HasAsync(Permission.UploadDocuments);
        canDelete = await Permissions.HasAsync(Permission.DeleteRecords);
        await LoadAsync();
    }

    private async Task LoadAsync() => documents = await Documents.ListForVehicleAsync(Vehicle.Row.Id);

    private async Task UploadAsync(DocumentType type, DocumentInfo? existing)
    {
        var parameters = new DialogParameters<UploadDocumentDialog>
        {
            { d => d.VehicleId, Vehicle.Row.Id },
            { d => d.Type, type },
            { d => d.Replacing, existing is not null },
            { d => d.ExistingNotes, existing?.Notes },
        };
        var dialog = await Dialogs.ShowAsync<UploadDocumentDialog>($"{(existing is null ? "Upload" : "Replace")} {DocumentTypes.Name(type)}", parameters);
        if ((await dialog.Result) is { Canceled: false })
        {
            Snackbar.Add($"{DocumentTypes.Name(type)} uploaded and ticked off on the checklist.", Severity.Success);
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
    }

    private async Task DeleteAsync(DocumentInfo doc)
    {
        var parameters = new DialogParameters<DeleteDocumentDialog>
        {
            { d => d.Type, doc.DocumentType },
            { d => d.FileName, doc.OriginalFileName },
        };
        var dialog = await Dialogs.ShowAsync<DeleteDocumentDialog>("Delete document copy", parameters);
        if ((await dialog.Result) is not { Canceled: false, Data: bool untick })
            return;

        var result = await Documents.DeleteAsync(doc.Id, untick);
        Snackbar.Add(result.Succeeded ? "Document copy deleted." : result.Error ?? "Couldn't delete the document.",
            result.Succeeded ? Severity.Success : Severity.Error);
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }
}
