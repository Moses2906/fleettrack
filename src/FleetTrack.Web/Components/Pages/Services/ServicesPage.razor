@page "/services"
@attribute [Authorize(Policy = nameof(Permission.ViewRecords))]
@inject ServiceLogService ServiceLog
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Services · FleetTrack</PageTitle>

<PageHeader Title="Services" Subtitle="What's due, and every service and repair so far.">
    <Actions>
        <AuthorizeView Policy="@nameof(Permission.AddServiceRecords)">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="() => LogAsync(null)">Log service</MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

<SectionCard Title="Due soon or overdue" Flush="true" Class="mb-4">
    <Actions>
        <MudSwitch @bind-Value="showAllReminders" Color="Color.Primary" Label="Show all booked" />
    </Actions>
    <ChildContent>
        @if (reminders is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (!VisibleReminders.Any())
        {
            <EmptyState Icon="@Icons.Material.Rounded.EventAvailable" Title="No services due" Message="Nothing is overdue or due in the next 30 days." />
        }
        else
        {
            @foreach (var r in VisibleReminders)
            {
                <ListRow>
                    <Main>
                        <MudLink Href="@($"vehicles/{r.VehicleId}?tab=services")" Class="ft-reg" Underline="Underline.Hover">@r.RegistrationNumber</MudLink>
                        <span class="ft-muted">@r.MakeAndModel · last serviced @r.LastServiceDate.ToString("dd MMM yyyy")</span>
                    </Main>
                    <Side>
                        <ServiceReminderChip DueDate="r.NextServiceDue" Today="today" />
                        <AuthorizeView Policy="@nameof(Permission.AddServiceRecords)">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => MarkDoneAsync(r)">Mark as done</MudButton>
                        </AuthorizeView>
                    </Side>
                </ListRow>
            }
        }
    </ChildContent>
</SectionCard>

<SectionCard Title="Service log" Flush="true">
    <div class="px-5 pt-2 pb-1">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="5">
                <MudTextField @bind-Value="search" Immediate="true" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Placeholder="Search registration, work or workshop" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Search" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudSelect T="WorkType?" @bind-Value="workType" Label="Type of work" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    @foreach (var type in Enum.GetValues<WorkType>())
                    {
                        <MudSelectItem T="WorkType?" Value="type">@DisplayNames.Of(type)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" md="4" Class="d-flex align-center justify-end">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @Filtered.Count() records · <b>@DisplayNames.Money(Filtered.Sum(s => s.Cost))</b>
                </MudText>
            </MudItem>
        </MudGrid>
    </div>
    <MudTable Items="services" Filter="Matches" Loading="services is null" Hover="true" Dense="true" Elevation="0" Breakpoint="Breakpoint.Sm" RowsPerPage="25">
        <HeaderContent>
            <MudTh>Date</MudTh><MudTh>Vehicle</MudTh><MudTh>Work</MudTh><MudTh>Workshop</MudTh>
            <MudTh Style="text-align: right">Odometer</MudTh><MudTh Style="text-align: right">Cost</MudTh><MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date" Style="white-space: nowrap">@context.ServiceDate.ToString("dd MMM yyyy")</MudTd>
            <MudTd DataLabel="Vehicle"><MudLink Href="@($"vehicles/{context.VehicleId}?tab=services")" Class="ft-reg" Underline="Underline.Hover">@context.RegistrationNumber</MudLink></MudTd>
            <MudTd DataLabel="Work">
                <MudText Typo="Typo.body2"><b>@DisplayNames.Of(context.WorkType)</b></MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Description</MudText>
            </MudTd>
            <MudTd DataLabel="Workshop">@context.Workshop</MudTd>
            <MudTd DataLabel="Odometer" Style="text-align: right; white-space: nowrap">@context.OdometerKm.ToString("#,##0") km</MudTd>
            <MudTd DataLabel="Cost" Style="text-align: right; white-space: nowrap">@DisplayNames.Money(context.Cost)</MudTd>
            <MudTd Style="text-align: right">
                @if (context.HasInvoice)
                {
                    <MudTooltip Text="@($"Invoice: {context.InvoiceFileName}")">
                        <MudIconButton Href="@($"invoices/{context.Id}")" Target="_blank" Icon="@Icons.Material.Rounded.Receipt" Size="Size.Small" aria-label="Open invoice" />
                    </MudTooltip>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><EmptyState Icon="@Icons.Material.Rounded.SearchOff" Title="No services match" /></NoRecordsContent>
        <PagerContent><MudTablePager PageSizeOptions="[25, 50, 100]" /></PagerContent>
    </MudTable>
</SectionCard>

@code {
    private List<ServiceRow>? services;
    private List<ServiceReminderRow>? reminders;
    private DateOnly today;
    private string search = "";
    private WorkType? workType;
    private bool showAllReminders;

    private IEnumerable<ServiceReminderRow> VisibleReminders =>
        (reminders ?? []).Where(r => showAllReminders || r.ReminderOn(today) is ServiceReminder.Overdue or ServiceReminder.DueSoon);

    private IEnumerable<ServiceRow> Filtered => (services ?? []).Where(Matches);

    protected override async Task OnInitializedAsync()
    {
        today = ServiceLog.Today;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        reminders = await ServiceLog.RemindersAsync();
        services = await ServiceLog.ListAsync();
    }

    private bool Matches(ServiceRow s)
    {
        if (workType is not null && s.WorkType != workType)
            return false;
        if (string.IsNullOrWhiteSpace(search))
            return true;

        var plateKey = RegistrationNumbers.ToKey(search);
        var plateMatches = plateKey.Length > 0 && RegistrationNumbers.ToKey(s.RegistrationNumber).Contains(plateKey);
        return plateMatches
            || s.Description.Contains(search, StringComparison.OrdinalIgnoreCase)
            || s.Workshop.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private Task LogAsync(int? vehicleId) => OpenServiceDialogAsync("Log service", vehicleId, markAsDone: false);

    private Task MarkDoneAsync(ServiceReminderRow reminder) =>
        OpenServiceDialogAsync($"Service done · {reminder.RegistrationNumber}", reminder.VehicleId, markAsDone: true);

    private async Task OpenServiceDialogAsync(string title, int? vehicleId, bool markAsDone)
    {
        var dialog = await Dialogs.ShowAsync<ServiceDialog>(title,
            new DialogParameters<ServiceDialog> { { d => d.VehicleId, vehicleId }, { d => d.MarkAsDone, markAsDone } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false } result)
        {
            Snackbar.Add(result.Data is DateOnly next ? $"Service saved. Next service booked for {next:dd MMM yyyy}." : "Service saved.", Severity.Success);
            await LoadAsync();
        }
    }
}
