@page "/vehicles"
@attribute [Authorize(Policy = nameof(Permission.ViewRecords))]
@inject VehicleService Vehicles
@inject ReferenceDataService ReferenceData
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Vehicles · FleetTrack</PageTitle>

<PageHeader Title="Vehicles" Subtitle="@Subtitle">
    <Actions>
        <AuthorizeView Policy="@nameof(Permission.EditRecords)">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="AddAsync">Add vehicle</MudButton>
        </AuthorizeView>
    </Actions>
</PageHeader>

<SectionCard Flush="true">
    <div class="px-5 pt-4 pb-1">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="search" Immediate="true" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Placeholder="Search registration, make, driver or owner"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Search" />
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudSelect T="StatusFilter" @bind-Value="status" Label="Licence disk" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="StatusFilter.All">All</MudSelectItem>
                    <MudSelectItem Value="StatusFilter.Attention">Needs attention</MudSelectItem>
                    <MudSelectItem Value="StatusFilter.Expired">Expired</MudSelectItem>
                    <MudSelectItem Value="StatusFilter.DueSoon">Due within 30 days</MudSelectItem>
                    <MudSelectItem Value="StatusFilter.Valid">Valid</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                @* Month picker: opens on the month view; the day is always the 1st. *@
                <MudDatePicker Date="@(expiringMonth?.FirstDay.ToDateTime(TimeOnly.MinValue))" DateChanged="MonthPicked" OpenTo="OpenTo.Month" FixDay="1"
                               DateFormat="MMMM yyyy" Label="Expiring in" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="4" md="2" Class="d-flex align-center">
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.Tune" OnClick="() => showMoreFilters = !showMoreFilters">
                    @(showMoreFilters ? "Fewer filters" : MoreFiltersLabel)
                </MudButton>
            </MudItem>
            @if (showMoreFilters)
            {
            <MudItem xs="6" sm="4" md="3">
                <MudSelect T="int?" @bind-Value="categoryId" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    @foreach (var c in categories)
                    {
                        <MudSelectItem T="int?" Value="c.Id">@c.Label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="4" md="3">
                <MudSelect T="int?" @bind-Value="driverId" Label="Driver" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    <MudSelectItem T="int?" Value="NoDriver">No driver assigned</MudSelectItem>
                    @foreach (var d in drivers)
                    {
                        <MudSelectItem T="int?" Value="d.Id">@d.Label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4" md="3" Class="d-flex align-center">
                <MudSwitch @bind-Value="missingDocsOnly" Color="Color.Error" Label="Missing documents only" />
            </MudItem>
            }
            <MudItem xs="12" Class="d-flex align-center justify-end flex-wrap gap-2 pt-0">
                @if (expiringMonth is { } m)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @Filtered.Count() disk(s) expiring in <b>@m.Display</b>
                    </MudText>
                }
            </MudItem>
        </MudGrid>
    </div>

    @* Phones: compact cards that expand when tapped. *@
    <div class="ft-mobile-only">
        @if (vehicles is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (!Filtered.Any())
        {
            @NoMatches
        }
        else
        {
            @foreach (var v in Filtered.Take(mobileLimit))
            {
                <div class="ft-vehicle-card @(expandedOnPhone.Contains(v.Id) ? "ft-expanded" : "")">
                    <button type="button" class="ft-vehicle-card-head" @onclick="() => Toggle(expandedOnPhone, v.Id)" aria-expanded="@(expandedOnPhone.Contains(v.Id) ? "true" : "false")">
                        <div class="d-flex align-center justify-space-between gap-2">
                            <span class="ft-reg">@v.RegistrationNumber</span>
                            <LicenceStatusChip ExpiryDate="v.LicenceExpiryDate" Today="today" HideWhenValid="true" />
                        </div>
                        <MudText Typo="Typo.body2">@v.MakeAndModel</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Disk @v.LicenceExpiryDate.ToString("dd MMM yyyy") · @(v.Driver ?? "No driver")</MudText>
                    </button>
                    @if (expandedOnPhone.Contains(v.Id))
                    {
                        <VehicleQuickView Row="v" Today="today" OnChanged="ReloadAsync" />
                    }
                </div>
            }
            @if (Filtered.Count() > mobileLimit)
            {
                <div class="pa-3 d-flex justify-center">
                    <MudButton Variant="Variant.Outlined" OnClick="() => mobileLimit += 30">Show more</MudButton>
                </div>
            }
        }
    </div>

    @* Tablets and computers: one line per vehicle; click a row to expand it. *@
    <MudTable T="VehicleRow" Items="vehicles" Filter="Matches" Loading="vehicles is null" Hover="true" Elevation="0"
              Breakpoint="Breakpoint.None" RowsPerPage="50" LoadingProgressColor="Color.Primary"
              Class="ft-clickable-rows ft-desktop-only ft-vehicle-table"
              OnRowClick="@((TableRowClickEventArgs<VehicleRow> e) => OnRowClick(e))"
              RowClassFunc="@((v, _) => expanded.Contains(v.Id) ? "ft-row-expanded" : "")">
        <HeaderContent>
            <MudTh><MudTableSortLabel InitialDirection="SortDirection.Ascending" SortBy="(VehicleRow v) => v.RegistrationNumber">Registration</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="(VehicleRow v) => v.MakeAndModel">Make & model</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="(VehicleRow v) => v.LicenceExpiryDate">Disk expiry</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="(VehicleRow v) => v.Driver ?? string.Empty">Driver</MudTableSortLabel></MudTh>
            <MudTh>Documents</MudTh>
            <MudTh Style="width: 48px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><span class="ft-reg">@context.RegistrationNumber</span></MudTd>
            <MudTd>@context.MakeAndModel</MudTd>
            <MudTd>
                <div class="d-flex align-center gap-2">
                    <span style="min-width: 88px">@context.LicenceExpiryDate.ToString("dd MMM yyyy")</span>
                    <LicenceStatusChip ExpiryDate="context.LicenceExpiryDate" Today="today" HideWhenValid="true" />
                </div>
            </MudTd>
            <MudTd>
                @if (context.Driver is null)
                {
                    <span class="mud-text-disabled">Unassigned</span>
                }
                else
                {
                    @context.Driver
                }
            </MudTd>
            <MudTd>
                @if (context.HasAllDocuments)
                {
                    <MudTooltip Text="All 4 documents on file">
                        <MudIcon Icon="@Icons.Material.Rounded.Check" Size="Size.Small" Class="mud-text-secondary" aria-label="All documents on file" />
                    </MudTooltip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Icon="@Icons.Material.Rounded.Error" Class="ma-0">@context.MissingDocumentCount missing</MudChip>
                }
            </MudTd>
            <MudTd Style="text-align: right">
                <MudIcon Icon="@(expanded.Contains(context.Id) ? Icons.Material.Rounded.ExpandLess : Icons.Material.Rounded.ExpandMore)"
                         Class="mud-text-secondary" />
            </MudTd>
        </RowTemplate>
        <ChildRowContent>
            @if (expanded.Contains(context.Id))
            {
                <MudTr>
                    <td colspan="6" class="ft-expanded-cell">
                        <VehicleQuickView Row="context" Today="today" OnChanged="ReloadAsync" />
                    </td>
                </MudTr>
            }
        </ChildRowContent>
        <NoRecordsContent>
            @if (vehicles is { Count: 0 })
            {
                <EmptyState Icon="@Icons.Material.Rounded.DirectionsCar" Title="No vehicles yet"
                            Message="Add your first vehicle to start tracking licence disks and documents." />
            }
            else
            {
                @NoMatches
            }
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="[25, 50, 100]" />
        </PagerContent>
    </MudTable>
</SectionCard>

@code {
    private enum StatusFilter { All, Attention, Expired, DueSoon, Valid }
    private const int NoDriver = -1;

    // Links from the dashboard and renewals open this page pre-filtered,
    // e.g. /vehicles?status=expired, ?missing=true or ?month=2026-11
    [SupplyParameterFromQuery(Name = "status")] public string? StatusQuery { get; set; }
    [SupplyParameterFromQuery(Name = "missing")] public bool? MissingQuery { get; set; }
    [SupplyParameterFromQuery(Name = "month")] public string? MonthQuery { get; set; }

    private List<VehicleRow>? vehicles;
    private List<Option> categories = [];
    private List<Option> drivers = [];
    // Phones and computers keep separate lists, so expanding in one doesn't load details in the hidden other.
    private readonly HashSet<int> expanded = [];
    private readonly HashSet<int> expandedOnPhone = [];
    private DateOnly today;

    private string search = "";
    private StatusFilter status;
    private YearMonth? expiringMonth;
    private int? categoryId;
    private int? driverId;
    private bool missingDocsOnly;
    private int mobileLimit = 30;
    private bool showMoreFilters;

    // Shows how many of the tucked-away filters are on, e.g. "More filters (2)".
    private string MoreFiltersLabel
    {
        get
        {
            var active = (categoryId is null ? 0 : 1) + (driverId is null ? 0 : 1) + (missingDocsOnly ? 1 : 0);
            return active == 0 ? "More filters" : $"More filters ({active})";
        }
    }

    private IEnumerable<VehicleRow> Filtered => (vehicles ?? []).Where(Matches);

    private string Subtitle => vehicles is null ? "Loading…" : $"{vehicles.Count} vehicles. Click a vehicle to see more.";

    protected override async Task OnParametersSetAsync()
    {
        today = Vehicles.Today;
        status = StatusQuery?.ToLowerInvariant() switch
        {
            "expired" => StatusFilter.Expired,
            "due" => StatusFilter.DueSoon,
            "attention" => StatusFilter.Attention,
            "valid" => StatusFilter.Valid,
            _ => StatusFilter.All,
        };
        missingDocsOnly = MissingQuery == true;
        showMoreFilters = missingDocsOnly;
        expiringMonth = YearMonth.TryParse(MonthQuery, out var month) ? month : null;

        categories = await ReferenceData.CategoryOptionsAsync();
        drivers = await ReferenceData.DriverOptionsAsync();
        vehicles = await Vehicles.ListAsync();
    }

    private async Task ReloadAsync() => vehicles = await Vehicles.ListAsync();

    private bool Matches(VehicleRow v)
    {
        if (categoryId is not null && v.CategoryId != categoryId) return false;
        if (driverId == NoDriver && v.DriverId is not null) return false;
        if (driverId is > 0 && v.DriverId != driverId) return false;
        if (missingDocsOnly && v.HasAllDocuments) return false;
        if (expiringMonth is { } month && !month.Contains(v.LicenceExpiryDate)) return false;

        var vehicleStatus = v.StatusOn(today);
        var statusMatches = status switch
        {
            StatusFilter.Expired => vehicleStatus == LicenceStatus.Expired,
            StatusFilter.DueSoon => vehicleStatus == LicenceStatus.DueSoon,
            StatusFilter.Valid => vehicleStatus == LicenceStatus.Valid,
            StatusFilter.Attention => vehicleStatus != LicenceStatus.Valid,
            _ => true,
        };
        if (!statusMatches) return false;

        if (string.IsNullOrWhiteSpace(search)) return true;
        var term = search.Trim();
        // Searching "CA123456" also finds "CA 123-456".
        var plateKey = RegistrationNumbers.ToKey(term);
        return (plateKey.Length > 0 && RegistrationNumbers.ToKey(v.RegistrationNumber).Contains(plateKey))
            || v.MakeAndModel.Contains(term, StringComparison.OrdinalIgnoreCase)
            || v.LicenceHolder.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (v.Driver?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private void MonthPicked(DateTime? date) =>
        expiringMonth = date is { } d ? YearMonth.Of(DateOnly.FromDateTime(d)) : null;

    private void OnRowClick(TableRowClickEventArgs<VehicleRow> e)
    {
        // Clicks inside an expanded row (e.g. on its buttons) also arrive here, without a vehicle: ignore them.
        if (e.Item is { } vehicle)
            Toggle(expanded, vehicle.Id);
    }

    private static void Toggle(HashSet<int> set, int vehicleId)
    {
        if (!set.Remove(vehicleId))
            set.Add(vehicleId);
    }

    private void ClearFilters()
    {
        search = "";
        status = StatusFilter.All;
        expiringMonth = null;
        categoryId = null;
        driverId = null;
        missingDocsOnly = false;
    }

    private RenderFragment NoMatches => @<EmptyState Icon="@Icons.Material.Rounded.SearchOff" Title="No vehicles match"
                                                     Message="Try a different search, or clear the filters.">
        <MudButton Variant="Variant.Outlined" OnClick="ClearFilters">Clear filters</MudButton>
    </EmptyState>;

    private async Task AddAsync()
    {
        var dialog = await Dialogs.ShowAsync<VehicleDialog>("Add vehicle", new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false, Data: int newId })
        {
            Snackbar.Add("Vehicle added.", Severity.Success);
            Navigation.NavigateTo($"vehicles/{newId}");
        }
    }
}
