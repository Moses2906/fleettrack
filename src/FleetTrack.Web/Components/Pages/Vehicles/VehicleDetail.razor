@page "/vehicles/{Id:int}"
@attribute [Authorize(Policy = nameof(Permission.ViewRecords))]
@inject VehicleService Vehicles
@inject PermissionService Permissions
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@(vehicle?.Row.RegistrationNumber ?? "Vehicle") · FleetTrack</PageTitle>

<MudButton Href="vehicles" Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.ArrowBack" Class="mb-2 ml-n2">All vehicles</MudButton>

@if (notFound)
{
    <EmptyState Icon="@Icons.Material.Rounded.SearchOff" Title="Vehicle not found" Message="It may have been deleted.">
        <MudButton Href="vehicles" Variant="Variant.Filled" Color="Color.Primary">Back to vehicles</MudButton>
    </EmptyState>
}
else if (vehicle is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    var v = vehicle.Row;
    <PageHeader Title="@v.RegistrationNumber" Subtitle="@($"{v.MakeAndModel}{(v.Year is null ? "" : $" · {v.Year}")} · {v.Category}")">
        <Actions>
            <MudButton Href="@($"history?vehicle={v.Id}")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.ManageSearch">History</MudButton>
            @if (canEdit)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Edit" OnClick="EditAsync">Edit</MudButton>
            }
            @if (canDelete)
            {
                <MudTooltip Text="Delete vehicle">
                    <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline" Color="Color.Error" OnClick="DeleteAsync" aria-label="Delete vehicle" />
                </MudTooltip>
            }
        </Actions>
    </PageHeader>

    @* One summary card with the key facts, laid out as simple label/value pairs. *@
    <SectionCard Class="mb-4">
        <div class="ft-facts-grid">
            <div>
                <div class="ft-fact-label">Licence disk</div>
                <div class="d-flex align-center gap-2 flex-wrap">
                    <span class="ft-fact-value">@v.LicenceExpiryDate.ToString("dd MMM yyyy")</span>
                    <LicenceStatusChip ExpiryDate="v.LicenceExpiryDate" Today="Vehicles.Today" />
                </div>
            </div>
            <div>
                <div class="ft-fact-label">Licensed to</div>
                <div class="ft-fact-value">@v.LicenceHolder</div>
                <div class="ft-muted">@(vehicle.HolderType == HolderType.Company ? "Reg. no." : "ID") @vehicle.HolderIdentifierForDisplay</div>
            </div>
            <div>
                <div class="ft-fact-label">Driver</div>
                <div class="ft-fact-value @(v.Driver is null ? "mud-text-disabled" : "")">@(v.Driver ?? "Unassigned")</div>
                @if (vehicle.DriverPhone is not null)
                {
                    <MudLink Href="@($"tel:{vehicle.DriverPhone.Replace(" ", "")}")" Typo="Typo.body2">@vehicle.DriverPhone</MudLink>
                }
            </div>
            <div>
                <div class="ft-fact-label">VIN</div>
                <div class="ft-fact-value">@(vehicle.Vin ?? "—")</div>
            </div>
        </div>
        @if (vehicle.Notes is not null)
        {
            <MudDivider Class="my-3" />
            <div class="ft-fact-label">Notes</div>
            @* pre-line keeps typed line breaks; Razor still HTML-encodes the text. *@
            <MudText Typo="Typo.body2" Style="white-space: pre-line">@vehicle.Notes</MudText>
        }
    </SectionCard>

    <SectionCard Flush="true">
        <MudTabs Elevation="0" ApplyEffectsToContainer="true" @bind-ActivePanelIndex="activeTab">
            <MudTabPanel Text="@($"Documents{(v.HasAllDocuments ? "" : $" · {v.MissingDocumentCount} missing")}")" Icon="@Icons.Material.Rounded.Description">
                <VehicleDocumentsPanel Vehicle="vehicle" OnChanged="LoadAsync" />
            </MudTabPanel>
            <MudTabPanel Text="Services" Icon="@Icons.Material.Rounded.Build">
                <VehicleServicesPanel VehicleId="v.Id" />
            </MudTabPanel>
            <MudTabPanel Text="Renewals" Icon="@Icons.Material.Rounded.Autorenew">
                <VehicleRenewalsPanel VehicleId="v.Id" CurrentExpiry="v.LicenceExpiryDate" OnChanged="LoadAsync" />
            </MudTabPanel>
        </MudTabs>
    </SectionCard>
}

@code {
    [Parameter] public int Id { get; set; }

    /// <summary>?tab=documents|services|renewals opens that tab directly (used by links elsewhere).</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private int activeTab;
    private VehicleDetails? vehicle;
    private bool notFound;
    private bool canEdit;
    private bool canDelete;

    protected override async Task OnParametersSetAsync()
    {
        // Only used to decide which buttons to show; the services check again on every action.
        canEdit = await Permissions.HasAsync(Permission.EditRecords);
        canDelete = await Permissions.HasAsync(Permission.DeleteRecords);
        activeTab = Tab?.ToLowerInvariant() switch { "services" => 1, "renewals" => 2, _ => 0 };
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        vehicle = await Vehicles.GetAsync(Id);
        notFound = vehicle is null;
    }

    private async Task EditAsync()
    {
        var parameters = new DialogParameters<VehicleDialog> { { d => d.VehicleId, Id } };
        var dialog = await Dialogs.ShowAsync<VehicleDialog>("Edit vehicle", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false })
        {
            Snackbar.Add("Vehicle updated.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task DeleteAsync()
    {
        var registration = vehicle!.Row.RegistrationNumber;
        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { d => d.Message, $"This permanently deletes {registration} together with all its documents, invoices, services and licence renewals. Use this for POPIA deletion requests or vehicles entered by mistake." },
            { d => d.ConfirmText, registration },
        };
        var dialog = await Dialogs.ShowAsync<ConfirmDeleteDialog>("Delete vehicle", parameters);
        if ((await dialog.Result) is not { Canceled: false })
            return;

        var result = await Vehicles.DeleteAsync(Id);
        if (result.Succeeded)
        {
            Snackbar.Add($"{registration} deleted.", Severity.Success);
            Navigation.NavigateTo("vehicles");
        }
        else
        {
            Snackbar.Add(result.Error ?? "Couldn't delete the vehicle.", Severity.Error);
        }
    }
}
