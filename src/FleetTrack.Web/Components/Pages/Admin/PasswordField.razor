@using FleetTrack.Web.Services

@* Password box with show/hide and a "generate" button. Passwords are checked against the rules on the server. *@
<MudTextField T="string" Value="Value" ValueChanged="ValueChanged" Label="Password" Variant="Variant.Outlined"
              InputType="@(visible ? InputType.Text : InputType.Password)"
              Adornment="Adornment.End" AdornmentIcon="@(visible ? Icons.Material.Rounded.VisibilityOff : Icons.Material.Rounded.Visibility)"
              OnAdornmentClick="() => visible = !visible" AdornmentAriaLabel="Show or hide password"
              HelperText="At least 12 characters, with upper and lower case letters, a number and a symbol."
              autocomplete="new-password" />
<div>
    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Rounded.Autorenew" OnClick="GenerateAsync">Generate a strong password</MudButton>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private bool visible = true;

    private Task GenerateAsync()
    {
        visible = true;
        return ValueChanged.InvokeAsync(UserAdminService.GeneratePassword());
    }
}
