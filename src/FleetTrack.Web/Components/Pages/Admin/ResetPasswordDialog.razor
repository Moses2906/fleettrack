@using FleetTrack.Web.Services
@inject UserAdminService UserAdmin

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width: min(420px, 80vw)">
            <MudText Typo="Typo.body2">
                Set a new password for <b>@User.FullName</b>. This also unlocks the account if it was locked.
            </MudText>
            <PasswordField @bind-Value="password" />
            @if (error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="saving">Reset password</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public UserSummary User { get; set; } = default!;

    private string? password = UserAdminService.GeneratePassword();
    private string? error;
    private bool saving;

    private async Task SaveAsync()
    {
        saving = true;
        var result = await UserAdmin.ResetPasswordAsync(User.Id, password ?? "");
        saving = false;

        if (result.Succeeded)
            Dialog.Close();
        else
            error = result.Error;
    }
}
